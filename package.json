{
  "name": "westshell",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --turbopack",
    "build": "next build",
    "build:bun": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun next lint",
    "patch:opennext": "bun scripts/patch-opennext-fast-set-immediate.mjs",
    "preview": "bun --bun opennextjs-cloudflare build && bun run patch:opennext && opennextjs-cloudflare preview",
    "deploy": "bun --bun opennextjs-cloudflare build && bun run patch:opennext && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
